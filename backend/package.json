{
  "name": "shopmate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ShopMate AI - Production Backend Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:embeddings": "tsx src/scripts/syncEmbeddings.ts",
    "db:hnsw": "tsx src/scripts/setupHnswIndex.ts",
    "test:search": "tsx src/scripts/testSearch.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/pino-http": "^5.8.4",
    "prisma": "^7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
